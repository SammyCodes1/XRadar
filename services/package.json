{
  "name": "@xradar/services",
  "version": "0.1.0",
  "private": true,
  "description": "XRadar serverless functions: detection, risk checks, AI synthesis, oracle publisher",
  "type": "module",
  "exports": {
    "./scanAndPublish": "./src/orchestrator/scanAndPublish.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/server.test.ts src/detection/erc20.test.ts src/social/announce.test.ts src/synthesis/score.test.ts",
    "scan:testnet": "tsx src/detection/run-local.ts --network testnet",
    "scan:mainnet": "tsx src/detection/run-local.ts --network mainnet",
    "risk:check": "tsx src/risk/run-local.ts",
    "pipeline:testnet": "tsx src/orchestrator/run-local.ts --chain testnet",
    "pipeline:mainnet": "tsx src/orchestrator/run-local.ts --chain mainnet",
    "x:announce": "tsx src/social/run-local.ts"
  },
  "dependencies": {
    "@xradar/shared": "0.1.0",
    "dotenv": "^16.6.1",
    "viem": "^2.55.16"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vercel/node": "^5.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
