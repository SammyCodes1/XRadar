{
  "crons": [
    {
      "path": "/api/discover",
      "schedule": "*/5 * * * *"
    }
  ],
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "installCommand": "npm install --prefix .."
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}
