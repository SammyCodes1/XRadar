{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "installCommand": "npm install --prefix .."
    },
    "jobs": {
      "root": "services",
      "installCommand": "npm install --prefix ..",
      "functions": {
        "api/cron/*.ts": {
          "maxDuration": 60
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/cron/(.*)",
      "destination": {
        "type": "service",
        "service": "jobs"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/scan-and-publish-testnet",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/scan-and-publish-mainnet",
      "schedule": "30 0 * * *"
    }
  ]
}
