# =============================================================================
# XRadar environment scaffolding
# Copy this file to .env (repo root) and/or to frontend/.env.local
# Never commit real secrets.
# =============================================================================

# --- Network: X Layer --------------------------------------------------------
# Mainnet chain ID 196. Testnet chain ID verified live via
# https://testrpc.xlayer.tech/terigon eth_chainId = 0x7a0 (1952).
# Re-check https://web3.okx.com/xlayer/faucet before using testnet in production.

XLAYER_MAINNET_RPC_URL=https://rpc.xlayer.tech
XLAYER_TESTNET_RPC_URL=https://testrpc.xlayer.tech/terigon
XLAYER_MAINNET_CHAIN_ID=196
XLAYER_TESTNET_CHAIN_ID=1952

# Optional fallback RPCs
XLAYER_MAINNET_RPC_FALLBACK_URL=https://xlayerrpc.okx.com
XLAYER_TESTNET_RPC_FALLBACK_URL=https://xlayertestrpc.okx.com/terigon

# --- Frontend (Next.js / wagmi) ---------------------------------------------
# Public vars must be prefixed NEXT_PUBLIC_
NEXT_PUBLIC_XLAYER_MAINNET_RPC_URL=https://rpc.xlayer.tech
NEXT_PUBLIC_XLAYER_TESTNET_RPC_URL=https://testrpc.xlayer.tech/terigon
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_DEFAULT_CHAIN_ID=1952
NEXT_PUBLIC_SERVICES_URL=http://localhost:8787
NEXT_PUBLIC_RISK_REGISTRY_TESTNET=0x6A85d6C8609B52d8B5eb0a9FC5F5174a4BaeeCf3
NEXT_PUBLIC_RISK_REGISTRY_MAINNET=

# --- Oracle publisher (separate wallets per network) ------------------------
ORACLE_WALLET_PRIVATE_KEY_TESTNET=
ORACLE_WALLET_PRIVATE_KEY_MAINNET=
ORACLE_CONTRACT_ADDRESS_TESTNET=0x6A85d6C8609B52d8B5eb0a9FC5F5174a4BaeeCf3
ORACLE_CONTRACT_ADDRESS_MAINNET=
ORACLE_WALLET_TESTNET=
ORACLE_WALLET_MAINNET=
# Optional: protect the Vercel cron route
CRON_SECRET=
X_ALERTS_ENABLED=true
X_ALERTS_MAINNET=true
X_ALERTS_TESTNET=false

# --- AI synthesis (services) ------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro

# --- X (Twitter) API --------------------------------------------------------
# User-context OAuth 1.0a from https://developer.x.com (Free tier can POST).
# Bearer tokens are app-only and cannot create posts.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=
X_ALERTS_ENABLED=true
X_ALERT_MIN_SCORE=70
FRONTEND_URL=http://localhost:3000

# --- Block explorer API (OKLink / OKX explorer) -----------------------------
EXPLORER_API_KEY=
EXPLORER_API_URL=https://www.oklink.com/api/v5

# --- OKX DEX aggregator (Wallet / X Routing on X Layer) ---------------------
# Web3 DEX API keys from https://web3.okx.com/build/dev-docs — not CEX keys.
# Optional. Without them the documented X Layer router is still known, but
# live quotes for tokens listed in OKX Wallet will not load.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_API_PASSPHRASE=
OKX_PROJECT_ID=
